{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow/universal-scoring-bundle/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "version",
    "probes",
    "dimensions"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow/universal-scoring-bundle/v1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "parameters": {
      "type": "object"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "default_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "probes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "command",
              "typesafe-batch",
              "llm-command"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "maxItems": 32
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3600
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_checks"
        ],
        "properties": {
          "contract_checks": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "components"
              ],
              "properties": {
                "components": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "probe",
                      "value",
                      "weight"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "probe": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "weight": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "mode"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^/"
                          },
                          "mode": {
                            "enum": [
                              "boolean",
                              "fraction",
                              "linear",
                              "threshold",
                              "mapping"
                            ]
                          },
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          },
                          "threshold": {
                            "type": "number"
                          },
                          "operator": {
                            "enum": [
                              ">=",
                              ">",
                              "<=",
                              "<",
                              "=="
                            ]
                          },
                          "mapping": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
