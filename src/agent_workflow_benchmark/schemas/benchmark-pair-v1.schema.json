{
  "$id": "agent-workflow/benchmark-pair/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arms": {
      "additionalProperties": false,
      "properties": {
        "control_raw": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "workflow_full": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "control_raw",
        "workflow_full"
      ],
      "type": "object"
    },
    "attempts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "minimum": 1,
            "type": "integer"
          },
          "attempt_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "evidence": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "terminal",
              "infrastructure_failed"
            ]
          }
        },
        "required": [
          "attempt",
          "attempt_id",
          "state",
          "evidence"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "base_revision": {
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "type": "string"
    },
    "benchmark_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "completed_at": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fixture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "infrastructure_retry_count": {
      "minimum": 0,
      "type": "integer"
    },
    "input_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pair_critical_path_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "pair_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "pair_nonce_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pair_start_skew_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "pair_sum_arm_wall_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "pair_wall_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "repetition": {
      "minimum": 1,
      "type": "integer"
    },
    "resource_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "agent-workflow/benchmark-pair/v1"
    },
    "selected_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "enum": [
        "terminal",
        "infrastructure_failed"
      ]
    },
    "task_prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "tool_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "run_id",
    "benchmark_id",
    "pair_id",
    "case_id",
    "repetition",
    "state",
    "base_revision",
    "fixture_sha256",
    "task_prompt_sha256",
    "input_bundle_sha256",
    "environment_sha256",
    "tool_policy_sha256",
    "resource_policy_sha256",
    "pair_nonce_sha256",
    "pair_wall_seconds",
    "pair_start_skew_seconds",
    "pair_sum_arm_wall_seconds",
    "pair_critical_path_seconds",
    "arms",
    "completed_at",
    "selected_attempt",
    "infrastructure_retry_count",
    "attempts"
  ],
  "type": "object"
}
