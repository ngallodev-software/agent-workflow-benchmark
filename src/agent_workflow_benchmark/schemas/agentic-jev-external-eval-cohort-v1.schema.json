{
  "$id": "agent-workflow-benchmark/agentic-jev-external-eval-cohort/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "agent-workflow-benchmark/agentic-jev-external-eval-cohort/v1"},
    "study_id": {"const": "agentic-jev-external-eval-scout-v1"},
    "development_only": {"const": true},
    "lineage": {"type": "object"},
    "sources": {"type": "object"},
    "selection_contract": {"type": "object"},
    "cohorts": {
      "type": "object",
      "properties": {
        "swe_lancer_manager_choice": {"type": "array", "minItems": 6, "maxItems": 6},
        "swe_bench_semantic_ambiguity": {"type": "array", "minItems": 6, "maxItems": 6}
      },
      "required": ["swe_lancer_manager_choice", "swe_bench_semantic_ambiguity"]
    },
    "execution_gate": {"type": "object"},
    "claim_boundary": {"type": "object"}
  },
  "required": [
    "schema", "study_id", "development_only", "lineage", "sources",
    "selection_contract", "cohorts", "execution_gate", "claim_boundary"
  ]
}
