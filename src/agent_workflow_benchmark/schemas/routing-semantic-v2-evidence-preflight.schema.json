    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "codex_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "const": "openai-api/codex-lb/deepseek-flash"
    },
    "passed": {
      "type": "boolean"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "IA-9": {
          "type": "object",
          "additionalProperties": true,
