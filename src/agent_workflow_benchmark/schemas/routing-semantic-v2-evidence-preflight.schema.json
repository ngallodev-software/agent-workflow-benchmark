        "IA-10": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "IA-11": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "IA-9",
        "IA-10",
        "IA-11"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
