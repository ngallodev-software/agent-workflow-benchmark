{
  "$id": "agent-workflow-benchmark/agentic-jev-decision-v2-manager-run/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "agent-workflow-benchmark/agentic-jev-decision-v2-manager-run/v1"},
    "study_id": {"const": "agentic-jev-decision-skill-v2"},
    "development_only": {"const": true},
    "v2_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activation_qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "type": "object",
      "properties": {
        "arm": {"const": "typesafe-plus-jev-decision-skill"},
        "source": {"const": "swe_lancer_manager_choice"},
        "samples_expected": {"const": 6},
        "samples_observed": {"const": 6},
        "success": {"type": "integer", "minimum": 0, "maximum": 6},
        "errors": {"type": "integer", "minimum": 0, "maximum": 6},
        "jev_tool_calls": {"type": "integer", "minimum": 0},
        "samples_with_jev_calls": {"type": "array", "items": {"type": "string"}},
        "scoring_enabled": {"const": false}
      },
      "required": [
        "arm", "source", "samples_expected", "samples_observed",
        "success", "errors", "jev_tool_calls", "samples_with_jev_calls",
        "scoring_enabled"
      ]
    },
    "samples": {"type": "array", "minItems": 6, "maxItems": 6},
    "claim_boundary": {"type": "object"}
  },
  "required": [
    "schema", "study_id", "development_only", "v2_lock_sha256",
    "activation_qualification_sha256", "execution", "samples", "claim_boundary"
  ]
}
