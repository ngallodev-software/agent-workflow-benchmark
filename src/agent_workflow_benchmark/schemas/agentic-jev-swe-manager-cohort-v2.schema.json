{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow-benchmark/agentic-jev-swe-manager-cohort/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "study_version",
    "created_at",
    "source",
    "selection",
    "tasks",
    "execution",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "agent-workflow-benchmark/agentic-jev-swe-manager-cohort/v2"
    },
    "study_id": {
      "const": "agentic-jev-swe-manager-v2"
    },
    "study_version": {
      "const": "2.0.0-preregistered"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "eval_version",
        "task",
        "task_variant",
        "split",
        "csv_path",
        "csv_sha256",
        "scorer",
        "scorer_path",
        "scorer_source_sha256"
      ],
      "properties": {
        "repository": {
          "const": "UKGovernmentBEIS/inspect_evals"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "eval_version": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "const": "inspect_evals/swe_lancer"
        },
        "task_variant": {
          "const": "swe_manager"
        },
        "split": {
          "const": "diamond"
        },
        "csv_path": {
          "type": "string",
          "minLength": 1
        },
        "csv_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "scorer": {
          "const": "inspect_evals.swe_lancer.scorers.swe_lancer_scorer"
        },
        "scorer_path": {
          "type": "string",
          "minLength": 1
        },
        "scorer_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "salt",
        "target_tasks",
        "gold_fields_used",
        "fields_read",
        "previously_observed_ids",
        "selection_sha256"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "salt": {
          "type": "string",
          "minLength": 1
        },
        "target_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "gold_fields_used": {
          "const": false
        },
        "fields_read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "previously_observed_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "selection_digest",
          "first_arm"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "selection_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "first_arm": {
            "enum": [
              "control",
              "treatment"
            ]
          }
        }
      }
    },
    "execution": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object"
    }
  }
}
