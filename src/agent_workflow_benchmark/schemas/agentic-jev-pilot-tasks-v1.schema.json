{
  "$id": "agent-workflow-benchmark/agentic-jev-pilot-tasks/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "agent-workflow-benchmark/agentic-jev-pilot-tasks/v1"
    },
    "study_id": {
      "const": "agentic-jev-pilot-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "development_only": {
      "const": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "authoring_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "task_id",
          "prompt",
          "files",
          "authoring_tags"
        ]
      }
    }
  },
  "required": [
    "schema",
    "study_id",
    "version",
    "development_only",
    "tasks"
  ]
}
