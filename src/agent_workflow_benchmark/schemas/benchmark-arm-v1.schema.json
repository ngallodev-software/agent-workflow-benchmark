{
  "$id": "agent-workflow/benchmark-arm/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm": {
      "enum": [
        "control_raw",
        "workflow_full"
      ]
    },
    "arm_wrapper_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "assistance": {
      "enum": [
        "none",
        "human",
        "steering"
      ]
    },
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "attempt_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "base_revision": {
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "type": "string"
    },
    "benchmark_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "case_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "completed_at": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "constraint_profile_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "constraint_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "effective_prompt_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "fixture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "git_evidence": {
      "additionalProperties": true,
      "type": "object"
    },
    "pair_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "phases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "active_process_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "completed_at": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "first_output_latency_seconds": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "human_review_seconds": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "phase_id": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "phase_wall_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "process": {
            "additionalProperties": true,
            "properties": {
              "argv": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "duration_seconds": {
                "minimum": 0,
                "type": "number"
              },
              "error_category": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "returncode": {
                "type": "integer"
              }
            },
            "required": [
              "argv",
              "returncode",
              "duration_seconds",
              "error_category"
            ],
            "type": "object"
          },
          "provider_elapsed_seconds": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "queue_wait_seconds": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "start_offset_seconds": {
            "minimum": 0,
            "type": "number"
          },
