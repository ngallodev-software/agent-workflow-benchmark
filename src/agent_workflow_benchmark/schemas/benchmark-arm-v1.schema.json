            "enum": [
              "completed",
              "task_failed",
              "infrastructure_failed",
              "timed_out"
            ]
          },
          "stderr": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "stdout": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
