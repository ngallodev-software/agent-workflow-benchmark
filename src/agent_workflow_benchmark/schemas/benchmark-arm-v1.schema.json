              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "first_output_latency_seconds": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "input_tokens": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
