                "type": "string"
              },
              "output_tokens": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "price_catalog_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider_billed_cost": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "provider_billed_cost_semantics": {
                "type": "string"
              },
              "provider_elapsed_seconds": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "provider_total_tokens": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "reasoning_output_tokens": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "retry_count": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "source": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "subscription_allocated_cost": {
                "minimum": 0,
                "type": [
                  "number",
                  "null"
