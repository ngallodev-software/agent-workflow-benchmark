{
  "$id": "agent-workflow-benchmark/agentic-jev-runtime-lock/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "agent-workflow-benchmark/agentic-jev-runtime-lock/v1"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "const": "agentic-jev-pilot-v1"
    },
    "inspect_ai_version": {
      "const": "0.3.268"
    },
    "inspect_swe_version": {
      "const": "0.2.71"
    },
    "codex_cli": {
      "type": "object"
    },
    "agent_model": {
      "const": "openai-api/codex-lb/gpt-6-luna"
    },
    "agent_model_args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responses_api": {
          "const": true
        }
      },
      "required": [
        "responses_api"
      ]
    },
    "jev_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_commit": {
          "const": "65a39f393687675ce170e6094757de20370365b9"
        },
        "upstream_release": {
          "const": "v0.5.7"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "upstream_commit",
        "upstream_release",
        "sha256"
      ]
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "const": 24
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "count",
        "version"
      ]
    },
    "tool": {
      "type": "object"
    },
    "docker": {
      "type": "object"
    },
    "frozen_for_pilot": {
      "const": true
    },
    "host_tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "const": "agent_workflow_benchmark.benchmarking.agentic_jev"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "typesafe_sdk_version": {
          "const": "0.6.0"
        }
      },
      "required": [
        "module",
        "implementation_sha256",
        "typesafe_sdk_version"
      ]
    },
    "inspect_harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "const": "agent_workflow_benchmark.benchmarking.inspect_adjudication"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "module",
        "implementation_sha256"
      ]
    },
    "sandbox_image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "const": "python:3.12-bookworm"
        },
        "image_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reference",
        "image_id",
        "repo_digests"
      ]
    },
    "agent_reasoning_effort": {
      "const": "high"
    },
    "codex_model_config": {
      "const": "gpt-6-luna"
    }
  },
  "required": [
    "schema",
    "created_at",
    "study_id",
    "inspect_ai_version",
    "inspect_swe_version",
    "codex_cli",
    "codex_model_config",
    "agent_model",
    "agent_reasoning_effort",
    "agent_model_args",
    "jev_model",
    "skill",
    "tasks",
    "tool",
    "host_tool",
    "inspect_harness",
    "docker",
    "sandbox_image",
    "frozen_for_pilot"
  ]
}
