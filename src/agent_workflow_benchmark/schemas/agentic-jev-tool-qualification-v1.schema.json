{
  "$id": "agent-workflow-benchmark/agentic-jev-tool-qualification/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "agent-workflow-benchmark/agentic-jev-tool-qualification/v1"
    },
    "study_id": {
      "const": "agentic-jev-pilot-v1"
    },
    "qualified": {
      "type": "boolean"
    },
    "runtime_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "study_id",
    "qualified",
    "runtime_lock_sha256",
    "checks"
  ]
}
