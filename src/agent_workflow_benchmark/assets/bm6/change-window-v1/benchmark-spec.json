  "visual": {
    "capture_argv": [
      "python",
      "-c",
      "raise SystemExit('visual capture is intentionally deferred until a post-seal scoring bundle is supplied')"
    ],
    "timeout_seconds": 120,
    "rubric_path": "visual-rubric.json",
    "runtime_lock_path": "visual-runtime-lock.json",
    "minimum_reviewers": {
      "development": 1,
      "internal": 2,
      "publication": 3
    }
  },
  "composite": {
    "machine_weight": 0.7,
    "human_weight": 0.3,
    "minimum_machine_score": 70,
    "minimum_human_score": 60
  },
  "winner_policy": {
    "enabled": false,
    "minimum_eligible_pairs": 10,
    "minimum_composite_delta": 5,
    "confidence_level": 0.95,
    "max_machine_regression": 3,
    "max_human_regression": 3
  },
  "scoring_contract_path": "scoring-contract.json",
  "live_review": {
    "server_argv": [
      "{python}",
      "-m",
      "change_window.server",
      "--host",
      "{host}",
      "--port",
      "{port}",
      "--data",
      "{worktree}/data/change-set.json"
    ],
    "host": "0.0.0.0",
    "ready_path": "/api/plan",
    "startup_timeout_seconds": 15
  }
