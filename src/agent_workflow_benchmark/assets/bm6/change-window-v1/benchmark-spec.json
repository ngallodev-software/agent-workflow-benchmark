{
  "schema": "agent-workflow/benchmark-spec/v3",
  "benchmark_id": "change-window-v1",
  "version": "1.0.0",
  "claim_level": "development",
  "canonical_task": "canonical-task.md",
  "fixture": {
    "id": "change-window-python-static-v1",
    "template_path": "fixture/starter",
    "target_input_path": "data/change-set.json"
  },
  "phases": [
    {
      "id": "analyze-plan",
      "name": "Analyze and plan",
      "prompt_path": "phases/01-analyze-plan.md",
      "timeout_seconds": 600
    },
    {
      "id": "implement",
      "name": "Implement",
      "prompt_path": "phases/02-implement.md",
      "timeout_seconds": 1200
    },
    {
      "id": "verify-repair",
      "name": "Verify and repair",
      "prompt_path": "phases/03-verify-repair.md",
      "timeout_seconds": 600
    }
  ],
  "arms": {
    "control": {
      "profile_id": "structured-direct/v1",
      "treatment_id": "structured-direct/v1",
      "runner": {
        "kind": "direct-executor",
        "agent_class": null
      },
      "wrapper_path": "profiles/workflow_full.md",
      "enabled_features": [
        "canonical task prompts",
        "benchmark-neutral safety envelope",
        "requirements traceability",
        "bounded plan-before-edit discipline",
        "acceptance-first verification",
        "self-review and drift audit"
      ],
      "disabled_features": [
        "Agent-Workflow Agent Run lifecycle"
      ]
    },
    "candidate": {
      "profile_id": "agent-workflow-bm5/v1",
      "treatment_id": "agent-workflow-bm5/v1",
      "runner": {
        "kind": "agent-workflow",
        "agent_class": "implementation"
      },
      "wrapper_path": "profiles/workflow_full.md",
      "enabled_features": [
        "canonical task prompts",
        "benchmark-neutral safety envelope",
        "requirements traceability",
        "bounded plan-before-edit discipline",
        "acceptance-first verification",
        "self-review and drift audit",
        "Agent-Workflow Agent Run lifecycle",
        "compact executor-context projection (OPT-001/004/007)",
        "host-owned deterministic gates (OPT-005)",
        "single agent-finish closeout transaction (OPT-010/011)",
        "host-derived acceptance criteria (OPT-012)",
        "steering-first exceptional worker protocol (OPT-013)",
        "per-command/cache amplification telemetry (OPT-014)",
        "conditional verify/repair model invocation (OPT-015)"
      ],
      "disabled_features": []
    }
  },
  "cases": [
    {
      "id": "standard-change-window",
      "input_path": "cases/change-set.json",
      "allowed_scope": {
        "writable_paths": [
          "README.md",
          "BENCHMARK_PLAN.md"
        ],
        "writable_trees": [
          "change_window",
          "tests"
        ],
        "disposable_trees": [
          ".pytest_cache",
          "__pycache__"
        ]
      }
    }
  ],
  "scheduling": {
    "default_repetitions": 1,
    "pair_concurrency": 1,
    "max_start_skew_seconds": 0.25,
    "infrastructure_retries": 1
  },
  "eligibility": {
    "required_guardrails": [
      "paired_identity",
      "declared_treatment",
      "start_skew",
      "writable_scope",
      "assistance_cohort",
      "provider_usage",
      "harness_integrity"
    ]
  },
  "machine_scoring": {
