{
  "schema": "agent-workflow/benchmark-spec/v1",
  "benchmark_id": "priority-picker-v1",
  "version": "1.1.0",
  "claim_level": "development",
  "canonical_task": "canonical-task.md",
  "fixture": {
    "id": "priority-picker-python-static-v1",
    "template_path": "fixture/starter",
    "target_input_path": "data/backlog.json"
  },
  "phases": [
    {
      "id": "analyze-plan",
      "name": "Analyze and plan",
      "prompt_path": "phases/01-analyze-plan.md",
      "timeout_seconds": 900
    },
    {
      "id": "implement",
      "name": "Implement",
      "prompt_path": "phases/02-implement.md",
      "timeout_seconds": 1800
    },
    {
      "id": "verify-repair",
      "name": "Verify and repair",
      "prompt_path": "phases/03-verify-repair.md",
      "timeout_seconds": 900
    }
  ],
  "arms": {
    "control_raw": {
      "profile_id": "control-raw/v1",
      "wrapper_path": "profiles/control_raw.md",
      "enabled_features": [
        "canonical task prompts",
        "benchmark-neutral safety envelope",
        "public tests and allowed local tools"
      ],
      "disabled_features": [
        "agent-workflow prompt-pack protocol",
        "agent-workflow skills",
        "agent-workflow planning and completion templates",
        "agent-workflow review and phase-gate procedures",
        "agent-workflow delegation and drift rules"
      ]
    },
    "workflow_full": {
      "profile_id": "workflow-full/v1",
      "wrapper_path": "profiles/workflow_full.md",
      "enabled_features": [
        "canonical task prompts",
        "benchmark-neutral safety envelope",
        "requirements traceability",
        "bounded plan-before-edit discipline",
        "writable-scope and non-target checks",
        "acceptance-first verification",
        "phase completion evidence",
        "self-review and drift audit"
      ],
      "disabled_features": []
    }
  },
  "cases": [
    {
      "id": "standard-backlog",
      "input_path": "cases/backlog-small.json",
      "allowed_scope": {
        "writable_paths": [
          "README.md",
          "BENCHMARK_PLAN.md"
        ],
        "writable_trees": [
          "priority_picker",
          "tests"
        ],
        "disposable_trees": [
          ".pytest_cache",
          "__pycache__"
        ]
      }
    }
  ],
  "scheduling": {
    "default_repetitions": 1,
    "pair_concurrency": 1,
    "max_start_skew_seconds": 0.25,
    "infrastructure_retries": 1
  },
  "eligibility": {
    "required_guardrails": [
      "paired_identity",
      "declared_treatment",
      "start_skew",
      "writable_scope",
      "assistance_cohort",
      "visual_capture",
      "provider_usage",
      "harness_integrity"
    ]
  },
  "machine_scoring": {
    "scorers": [
      {
        "id": "hidden-functional-v1",
        "dimension": "hidden_functional",
        "kind": "command-v1",
        "max_points": 45,
        "argv": [
          "python",
          "{suite}/evaluation/evaluate.py",
          "--dimension",
          "hidden_functional",
          "--worktree",
          "{worktree}",
          "--result",
          "{result_file}",
          "--max-points",
          "{max_points}"
        ],
        "timeout_seconds": 120
      },
      {
        "id": "public-regression-v1",
        "dimension": "public_regression",
        "kind": "command-v1",
        "max_points": 15,
        "argv": [
          "python",
          "{suite}/evaluation/evaluate.py",
          "--dimension",
          "public_regression",
          "--worktree",
          "{worktree}",
          "--result",
          "{result_file}",
          "--max-points",
          "{max_points}"
        ],
        "timeout_seconds": 120
      },
      {
        "id": "robustness-v1",
        "dimension": "robustness",
        "kind": "command-v1",
        "max_points": 10,
        "argv": [
          "python",
          "{suite}/evaluation/evaluate.py",
          "--dimension",
          "robustness",
          "--worktree",
          "{worktree}",
          "--result",
          "{result_file}",
          "--max-points",
          "{max_points}"
        ],
        "timeout_seconds": 120
      },
      {
        "id": "accessibility-ui-v1",
        "dimension": "accessibility_ui",
        "kind": "command-v1",
        "max_points": 10,
        "argv": [
          "python",
          "{suite}/evaluation/evaluate.py",
          "--dimension",
          "accessibility_ui",
          "--worktree",
          "{worktree}",
          "--stage-dir",
          "{stage_dir}",
          "--result",
          "{result_file}",
          "--max-points",
          "{max_points}"
        ],
        "timeout_seconds": 60
      },
      {
        "id": "scope-completeness-v1",
        "dimension": "scope_completeness",
        "kind": "command-v1",
        "max_points": 10,
        "argv": [
          "python",
          "{suite}/evaluation/evaluate.py",
          "--dimension",
          "scope_completeness",
          "--worktree",
          "{worktree}",
          "--result",
          "{result_file}",
          "--max-points",
          "{max_points}"
        ],
        "timeout_seconds": 60
      },
      {
        "id": "engineering-quality-v1",
        "dimension": "engineering_quality",
        "kind": "command-v1",
        "max_points": 10,
        "argv": [
          "python",
          "{suite}/evaluation/evaluate.py",
          "--dimension",
          "engineering_quality",
          "--worktree",
          "{worktree}",
          "--result",
          "{result_file}",
          "--max-points",
          "{max_points}"
        ],
        "timeout_seconds": 120
      }
    ]
  },
  "visual": {
    "capture_argv": [
      "python",
      "{suite}/evaluation/capture_visual.py",
      "--worktree",
      "{worktree}",
      "--output",
      "{visual_dir}",
      "--runtime-lock",
      "{runtime_lock}"
    ],
    "timeout_seconds": 180,
    "rubric_path": "visual-rubric.json",
    "runtime_lock_path": "visual-runtime-lock.json",
    "minimum_reviewers": {
      "development": 1,
      "internal": 2,
      "publication": 3
    }
  },
  "composite": {
    "machine_weight": 0.7,
    "human_weight": 0.3,
    "minimum_machine_score": 70,
    "minimum_human_score": 60
  },
  "winner_policy": {
    "enabled": false,
    "minimum_eligible_pairs": 10,
    "minimum_composite_delta": 5,
    "confidence_level": 0.95,
    "max_machine_regression": 3,
    "max_human_regression": 3
  }
}
